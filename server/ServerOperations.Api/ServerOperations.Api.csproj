<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServerOperations.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.MySqlStorage" Version="2.0.3" />
    <!--
      Hangfire.MySqlStorage が引き込む Dapper 1.50.5 は System.Data.SqlClient 4.4.0 に依存し、
      そこに高深刻度の脆弱性がある(GHSA-98g6-xh36-x2p7)。
      MySQL運用では読み込まれないコードだが、依存として残さないため Dapper を上げて断つ。
    -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Hangfire.NetCore" Version="1.8.23" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.17">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Otp.NET" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerOperations.Core\ServerOperations.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ServerOperations.Core" />
  </ItemGroup>

</Project>

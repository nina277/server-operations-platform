<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ServerOperations.Worker-b0f0a28b-a2d3-46fc-9ece-0c2ce1ac1c15</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.MySqlStorage" Version="2.0.3" />
    <!--
      Hangfire.MySqlStorage が引き込む Dapper 1.50.5 は System.Data.SqlClient 4.4.0 に依存し、
      そこに高深刻度の脆弱性がある(GHSA-98g6-xh36-x2p7)。
      MySQL運用では読み込まれないコードだが、依存として残さないため Dapper を上げて断つ。
    -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Hangfire.NetCore" Version="1.8.23" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerOperations.Core\ServerOperations.Core.csproj" />
  </ItemGroup>
</Project>
